generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String        @unique
  password     String
  refreshTokens RefreshToken[]
  currencyId   String        @db.Uuid
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  accounts     Account[]
  categories   Category[]
  debts        Debt[]
  goals        Goal[]
  transactions Transaction[]
  currency     Currency      @relation(fields: [currencyId], references: [id])
}

model RefreshToken {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token      String   @unique
  userId     String   @db.Uuid
  deviceInfo String? 
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  revoked    Boolean  @default(false)

  user       User     @relation(fields: [userId], references: [id])
}


model Account {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  balance          Float
  order            Int           @default(0)
  userId           String        @db.Uuid
  currencyId       String        @db.Uuid
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  currency         Currency      @relation(fields: [currencyId], references: [id])
  user             User          @relation(fields: [userId], references: [id])
  transactionsFrom Transaction[] @relation("TransactionFrom")
  transactionsTo   Transaction[] @relation("TransactionTo")
  transactions     Transaction[] @relation("TransactionAccount")
}

model Category {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  type          CategoryType
  icon          String
  color         String
  order         Int           @default(0)
  userId        String        @db.Uuid
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  user          User          @relation(fields: [userId], references: [id])
  subcategories Subcategory[]
  transactions  Transaction[]
}

model Subcategory {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  categoryId   String        @db.Uuid
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  category     Category      @relation(fields: [categoryId], references: [id])
  transactions Transaction[]
}

model Transaction {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type          TransactionType
  date          DateTime             @db.Timestamp(6)
  description   String?
  accountId     String?              @db.Uuid
  categoryId    String?              @db.Uuid
  subcategoryId String?              @db.Uuid
  amount        Float?
  accountIdFrom String?              @db.Uuid
  accountIdTo   String?              @db.Uuid
  amountFrom    Float?
  amountTo      Float?
  goalId        String?              @db.Uuid
  goalType      GoalTransactionType?
  debtId        String?              @db.Uuid
  userId        String               @db.Uuid
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  accountFrom   Account?             @relation("TransactionFrom", fields: [accountIdFrom], references: [id])
  accountTo     Account?             @relation("TransactionTo", fields: [accountIdTo], references: [id])
  account       Account?             @relation("TransactionAccount", fields: [accountId], references: [id])
  category      Category?            @relation(fields: [categoryId], references: [id])
  debt          Debt?                @relation(fields: [debtId], references: [id])
  goal          Goal?                @relation(fields: [goalId], references: [id])
  subcategory   Subcategory?         @relation(fields: [subcategoryId], references: [id])
  user          User                 @relation(fields: [userId], references: [id])
}

model Currency {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String
  code              String         @unique
  symbol            String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  accounts          Account[]
  exchangeRatesFrom ExchangeRate[] @relation("FromCurrency")
  exchangeRatesTo   ExchangeRate[] @relation("ToCurrency")
  users             User[]
}

model ExchangeRate {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fromId    String   @db.Uuid
  toId      String   @db.Uuid
  rate      Float
  date      DateTime @default(now()) @db.Timestamp(6)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  from      Currency @relation("FromCurrency", fields: [fromId], references: [id])
  to        Currency @relation("ToCurrency", fields: [toId], references: [id])

  @@unique([fromId, toId], name: "fromId_toId")
}

model Goal {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  target_amount Float
  saved_amount  Float
  deadline      DateTime
  description   String?
  icon          String
  userId        String        @db.Uuid
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  user          User          @relation(fields: [userId], references: [id])
  transactions  Transaction[]
}

model Debt {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  target_amount Float
  saved_amount  Float
  deadline      DateTime
  paid          Boolean
  type          DebtType
  description   String?
  userId        String        @db.Uuid
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  user          User          @relation(fields: [userId], references: [id])
  transactions  Transaction[]
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  GOAL
  DEBT
}

enum DebtType {
  OWED_TO_ME
  OWED_BY_ME
}

enum GoalTransactionType {
  DEPOSIT
  WITHDRAW
}
